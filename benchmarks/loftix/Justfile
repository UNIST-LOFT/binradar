# Recipe to build all projects and bugs in the loftix benchmark
# Run in benchmarks/loftix: cd benchmarks/loftix && just build-all

build-all:
    #!/usr/bin/env bash
    for project in *; do \
        if [ -d "$project" ]; then \
            for bug in "$project"/*; do \
                # If directory, run just build
                if [ -d "$bug" ]; then \
                    if [ -f "$bug/config.env" ]; then \
                        echo "Building $bug"; \
                        (cd "$bug" && just build); \
                    else \
                        echo "Skipping $bug, no config.env found"; \
                    fi; \
                fi; \
            done; \
        fi; \
    done;

# Internal helper
@_run-all command jobs prefix workdir:
    #!/usr/bin/env bash
    mkdir -p logs
    find . -maxdepth 3 -name config.env -exec dirname {} \; \
    | parallel --tag --joblog logs/{{command}}.joblog --results logs/{{command}}-results -j {{jobs}} '
      cd "{}" && just {{command}} {{workdir}}
    '

@_run-from-file command argfile jobs prefix workdir:
    #!/usr/bin/env bash
    mkdir -p logs/{{command}}-results
    parallel --tag --joblog "logs/{{command}}.joblog" --results logs/{{command}}-results -j {{jobs}} \
      'cd "{}" && just {{command}} {{workdir}}' \
      :::: "{{argfile}}"

@_resume-from-file command argfile jobs prefix workdir:
    #!/usr/bin/env bash
    mkdir -p logs/{{command}}-results
    parallel --resume --tag --joblog "logs/{{command}}.joblog" --results logs/{{command}}-results -j {{jobs}} \
      'cd "{}" && just {{command}} {{workdir}}' \
      :::: "{{argfile}}"

list out="exp.list":
    mkdir -p "$(dirname {{out}})"
    find . -maxdepth 3 -name config.env -exec dirname {} \; | sort -u > {{out}}
    echo "Experiment list ({{out}}): $(wc -l < {{out}})"

failed command out="failed.list":
    #!/usr/bin/env bash
    awk 'NR>1 && $7!=0' logs/{{command}}.joblog \
      | sed -E 's/^.*cd "([^"]+)".*$/\1/' \
      > {{out}}
    echo "Failures ({{out}}): $(wc -l < {{out}})"

success command out="success.list":
    #!/usr/bin/env bash
    awk 'NR>1 && $7==0' logs/{{command}}.joblog \
      | sed -E 's/^.*cd "([^"]+)".*$/\1/' \
      > {{out}}
    echo "Successes ({{out}}): $(wc -l < {{out}})"

run cmd argfile="exp.list" jobs="20" workdir="workdir":
    just _run-from-file {{cmd}} {{argfile}} {{jobs}} "{{cmd}} RUN" {{workdir}}

resume cmd argfile="exp.list" jobs="20" workdir="workdir":
    just _resume-from-file {{cmd}} {{argfile}} {{jobs}} "{{cmd}} RESUME" {{workdir}}

run-all cmd jobs="20" workdir="workdir":
    just _run-all {{cmd}} {{jobs}} "{{cmd}} RUN" {{workdir}}

clean-all workdir="workdir":
    rm -rf */*/{{workdir}}