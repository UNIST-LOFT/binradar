# Recipe to build all projects and bugs in the loftix benchmark
# Run in benchmarks/loftix: cd benchmarks/loftix && just build-all

# sequential
run-all cmd:
    #!/usr/bin/env bash
    for project in *; do \
        if [ -d "$project" ]; then \
            for bug in "$project"/*; do \
                # If directory, run just build
                if [ -d "$bug" ]; then \
                    if [ -f "$bug/config.env" ]; then \
                        echo "Building $bug"; \
                        (cd "$bug" && {{cmd}}); \
                    else \
                        echo "Skipping $bug, no config.env found"; \
                    fi; \
                fi; \
            done; \
        fi; \
    done;

# parallel
@_run-all name command jobs:
    #!/usr/bin/env bash
    mkdir -p logs
    find . -maxdepth 3 -name config.env -exec dirname {} \; \
    | parallel --tag --joblog logs/{{name}}.tsv --results logs/{{name}}-results -j {{jobs}} '
      cd "{}" && {{command}}
    '

@_run-from-file command argfile jobs prefix workdir:
    #!/usr/bin/env bash
    mkdir -p logs/{{command}}-results
    parallel --tag --joblog "logs/{{command}}.tsv" --results logs/{{command}}-results -j {{jobs}} \
      'cd "{}" && just {{command}} {{workdir}}' \
      :::: "{{argfile}}"

@_resume-from-file command argfile jobs prefix workdir:
    #!/usr/bin/env bash
    mkdir -p logs/{{command}}-results
    parallel --resume --tag --joblog "logs/{{command}}.tsv" --results logs/{{command}}-results -j {{jobs}} \
      'cd "{}" && just {{command}} {{workdir}}' \
      :::: "{{argfile}}"

list out="exp.list":
    mkdir -p "$(dirname {{out}})"
    find . -maxdepth 3 -name config.env -exec dirname {} \; | sort -u > {{out}}
    echo "Experiment list ({{out}}): $(wc -l < {{out}})"

failed command out="failed.list":
    #!/usr/bin/env bash
    awk 'NR>1 && $7!=0' logs/{{command}}.tsv \
      | sed -E 's/^.*cd "([^"]+)".*$/\1/' \
      > {{out}}
    echo "Failures ({{out}}): $(wc -l < {{out}})"

success command out="success.list":
    #!/usr/bin/env bash
    awk 'NR>1 && $7==0' logs/{{command}}.tsv \
      | sed -E 's/^.*cd "([^"]+)".*$/\1/' \
      > {{out}}
    echo "Successes ({{out}}): $(wc -l < {{out}})"

run cmd argfile="exp.list" jobs="30" workdir="workdir":
    just _run-from-file {{cmd}} {{argfile}} {{jobs}} "{{cmd}} RUN" {{workdir}}

resume cmd argfile="exp.list" jobs="30" workdir="workdir":
    just _resume-from-file {{cmd}} {{argfile}} {{jobs}} "{{cmd}} RESUME" {{workdir}}


build-all:
    just run-all "just build"

backup-all workdir_old="workdir" workdir_bak="workdir-bak":
    just _run-all backup "mv {{workdir_old}} {{workdir_bak}}" 30

clean-all workdir="workdir":
    just _run-all clean "rm -rf {{workdir}}" 30

eval-all workdir="workdir" fuzzer="sdfuzz" fuzz_out_root="/home/binradar/code/loftix/loftix-benchmarks" argfile="exp.list" jobs="30":
    #!/usr/bin/env bash
    mkdir -p logs/eval-{{fuzzer}}-results
    parallel --tag --joblog logs/eval-{{fuzzer}}.tsv --results logs/eval-{{fuzzer}}-results -j {{jobs}} \
      'cd "{}" && just eval "{{workdir}}" "{{fuzzer}}" "{{fuzz_out_root}}/{}/work-{{fuzzer}}/out"' \
      :::: "{{argfile}}"