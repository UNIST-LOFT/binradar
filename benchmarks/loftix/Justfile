# Recipe to build all projects and bugs in the loftix benchmark
# Run in benchmarks/loftix: cd benchmarks/loftix && just build-all

build-all:
    #!/bin/bash
    for project in *; do \
        if [ -d "$project" ]; then \
            for bug in "$project"/*; do \
                # If directory, run just build
                if [ -d "$bug" ]; then \
                    (cd "$bug" && echo "Building $bug" && just build); \
                fi; \
            done; \
        fi; \
    done;

# Internal helper
@_run-all command jobs prefix:
    #!/bin/bash
    mkdir -p logs
    find . -maxdepth 3 -name config.env -exec dirname {} \; \
    | parallel --joblog logs/{{command}}.txt -j {{jobs}} '
      echo "### {{prefix}} {}"
      cd "{}" && just {{command}}
    '

@_rerun-all command jobs prefix:
    #!/bin/bash
    mkdir -p logs
    find . -maxdepth 3 -name config.env -exec dirname {} \; \
    | parallel --joblog logs/{{command}}.txt -j {{jobs}} '
      echo "### {{prefix}} {}"
      cd "{}" && just {{command}} || (echo "{{prefix}} FAILED FOR {}" && just {{command}})
    '

taosc-all jobs="20":
    just _run-all taosc {{jobs}} "TAOSC RUN"

setup-all jobs="20":
    just _run-all setup {{jobs}} "SETUP RUN"

binradar-all jobs="20":
    just _run-all binradar {{jobs}} "BINRADAR RUN"
